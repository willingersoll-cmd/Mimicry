{
  "name": "vibecheck-proxy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "playwright:install": "node node_modules/playwright/cli.js install chromium",
    "calibrate:effort": "rm -rf .calib && node node_modules/typescript/bin/tsc lib/gomsEffortModel.ts scripts/calibrateEffort.ts --outDir .calib --module commonjs --target es2020 --moduleResolution node --esModuleInterop --skipLibCheck && node .calib/scripts/calibrateEffort.js && rm -rf .calib"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "ai": "^3.0.0",
    "framer-motion": "^12.40.0",
    "next": "^14.2.0",
    "pixelarticons": "^2.1.2",
    "playwright": "^1.45.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0"
  }
}
